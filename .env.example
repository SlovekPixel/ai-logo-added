# Exactly 30 characters — change before deploy
ACCESS_CODE=demo-access-code-30chars-here!

# Long random string for session cookies
SECRET_KEY=change-this-to-a-long-random-string

# Cloud platforms inject PORT; local default is 8000
# PORT=8000

MAX_FILES=200
MAX_FILE_MB=10
MAX_TOTAL_MB=300
ZIP_TTL_MINUTES=20

# Set true behind HTTPS (Railway/Render/Fly) so session cookie is Secure
COOKIE_SECURE=false
